# Copy to bianca/.env on the Mac mini and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_ALLOWED_CHAT_ID=      # your own chat id; the bot ignores everyone else

# Path to the Claude Code CLI on the mini (the "brain": OCR, Airtable, drafting, Gmail).
# The bot shells out to this so it reuses your Claude Code login + the bianca-card-flow Skill.
CLAUDE_BIN=claude

# Absolute path to this repo on the mini, so `claude -p` loads the Skill from .claude/skills.
REPO_DIR=/Users/YOU/path/to/goblin2929.github.io
